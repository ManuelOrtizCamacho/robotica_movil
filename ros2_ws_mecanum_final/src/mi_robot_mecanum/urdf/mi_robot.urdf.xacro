<?xml version="1.0"?>
<!-- Robot Mecanum + RPLIDAR A3 — Examen final Robótica Móvil
     La geometría (a, wheelbase, track) llega desde el launch según el carné:
     xacro mi_robot.urdf.xacro rueda_radio:=0.05 distancia_ejes:=0.30 separacion_ruedas:=0.28 -->
<robot name="mi_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="rueda_radio" default="0.05"/>
  <xacro:arg name="distancia_ejes" default="0.30"/>
  <xacro:arg name="separacion_ruedas" default="0.28"/>

  <!-- ===================== Parámetros ===================== -->
  <xacro:property name="rueda_radio" value="$(arg rueda_radio)"/>
  <xacro:property name="distancia_ejes" value="$(arg distancia_ejes)"/>        <!-- wheelbase -->
  <xacro:property name="separacion_ruedas" value="$(arg separacion_ruedas)"/>  <!-- track -->
  <xacro:property name="lx" value="${distancia_ejes / 2.0}"/>
  <xacro:property name="ly" value="${separacion_ruedas / 2.0}"/>
  <xacro:property name="rueda_ancho" value="0.04"/>
  <xacro:property name="rueda_masa" value="0.3"/>

  <xacro:property name="chasis_largo" value="${distancia_ejes + 0.04}"/>
  <xacro:property name="chasis_ancho" value="${separacion_ruedas - rueda_ancho - 0.02}"/>
  <xacro:property name="chasis_alto" value="0.05"/>
  <xacro:property name="chasis_masa" value="3.0"/>

  <!-- ===================== Inercias ===================== -->
  <xacro:macro name="inercia_caja" params="m x y z">
    <inertia ixx="${m*(y*y + z*z)/12.0}" ixy="0" ixz="0"
             iyy="${m*(x*x + z*z)/12.0}" iyz="0"
             izz="${m*(x*x + y*y)/12.0}"/>
  </xacro:macro>
  <!-- Cilindro con eje a lo largo de z local -->
  <xacro:macro name="inercia_cilindro" params="m r h">
    <inertia ixx="${m*(3*r*r + h*h)/12.0}" ixy="0" ixz="0"
             iyy="${m*(3*r*r + h*h)/12.0}" iyz="0"
             izz="${m*r*r/2.0}"/>
  </xacro:macro>

  <!-- ===================== Chasis ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="${chasis_largo} ${chasis_ancho} ${chasis_alto}"/></geometry>
      <material name="azul"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="${chasis_largo} ${chasis_ancho} ${chasis_alto}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="${chasis_masa}"/>
      <xacro:inercia_caja m="${chasis_masa}" x="${chasis_largo}" y="${chasis_ancho}" z="${chasis_alto}"/>
    </inertial>
  </link>

  <!-- ===================== Ruedas ===================== -->
  <!-- El link se llama rueda_<prefijo> y su colisión es una esfera: el launch le
       añade la fricción que emula los rodillos a 45° (launch/sdf_mecanum.py). -->
  <xacro:macro name="rueda" params="prefijo x_signo y_signo">
    <link name="rueda_${prefijo}">
      <visual>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
        <material name="negro"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${rueda_radio}"/></geometry>
      </collision>
      <inertial>
        <mass value="${rueda_masa}"/>
        <xacro:inercia_cilindro m="${rueda_masa}" r="${rueda_radio}" h="${rueda_ancho}"/>
      </inertial>
    </link>

    <joint name="joint_rueda_${prefijo}" type="continuous">
      <parent link="base_link"/>
      <child link="rueda_${prefijo}"/>
      <!-- rpy = -π/2: el eje z de la rueda queda apuntando a +y, así ω > 0 hace avanzar al robot en +x -->
      <origin xyz="${x_signo*lx} ${y_signo*ly} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:rueda prefijo="del_izq" x_signo="1"  y_signo="1"/>
  <xacro:rueda prefijo="del_der" x_signo="1"  y_signo="-1"/>
  <xacro:rueda prefijo="tra_izq" x_signo="-1" y_signo="1"/>
  <!-- TODO (R-1): instanciar la rueda trasera derecha (tra_der) -->

  <!-- ===================== RPLIDAR A3 ===================== -->
  <!-- TODO (R-2): RPLIDAR A3 con los valores de su carné y de la hoja de datos
       1. link "lidar_link": cilindro con el diámetro, alto y masa reales, y su inercia
          (use la macro inercia_cilindro)
       2. joint fijo "joint_lidar" de base_link a lidar_link en (x, 0, z) de su carné
       3. <gazebo reference="lidar_link"> con un <sensor type="gpu_lidar">:
          - topic /scan  y  gz_frame_id lidar_link
          - update_rate = frecuencia de barrido de su carné
          - samples = muestras por segundo (según el modo) / frecuencia de barrido
          - ángulo de -π a π, rango mínimo y máximo del modo
          - ruido gaussiano con σ = 0.01 m -->

  <!-- ===================== Plugins de Gazebo ===================== -->
  <!-- Motor: un JointController por rueda; recibe ω (rad/s) en /vel_rueda_<prefijo>. -->
  <xacro:macro name="motor" params="prefijo">
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>joint_rueda_${prefijo}</joint_name>
      <use_force_commands>false</use_force_commands>
      <topic>/vel_rueda_${prefijo}</topic>
    </plugin>
  </xacro:macro>

  <gazebo>
    <xacro:motor prefijo="del_izq"/>
    <xacro:motor prefijo="del_der"/>
    <xacro:motor prefijo="tra_izq"/>
    <!-- TODO (R-1): motor de la rueda trasera derecha -->
    <!-- Encoders: publica el estado de las ruedas -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>
